.idea
vendor/
loadtest/reports/*
# Keep the small evidence files behind docs/benchmarks.md; the bulky
# generated HTML and raw k6 JSON stay ignored.
!loadtest/reports/*-steps.json
!loadtest/reports/ab/
!loadtest/reports/ab/*-steps.json
!loadtest/reports/drain/
!loadtest/reports/drain/*.json

# Build output
bin/

# Local database files (the database now runs as a service)
*.sqlite3

# Fetched by `make loadtest-deps`, not source
loadtest/scripts/lib/vendor/

# Machine-local port overrides (see WS_HOST_PORT in the Makefile). Read by both
# docker compose and make; never committed, because the right value differs per
# machine — macOS holds 7000 for AirPlay, other hosts do not.
.env
